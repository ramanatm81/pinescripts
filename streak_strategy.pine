//@version=6
// =====================================================================================
// STREAK TREND STRATEGY
//
// Trades the Streak Trend Detector (see streak_detector.pine "Kobe") as a trend-follower:
//   trend state = +1 (UP)   -> LONG
//   trend state = -1 (DOWN) -> SHORT
// Detection is IDENTICAL to the indicator: median-3 smoothed high/low -> confirmed pivots
// (pivLen bars each side, so a pivLen-bar confirmation lag, no lookahead) -> LH/LL vs HH/HL
// streak -> OLS displacement gate (confN/confRunPts, R2 deliberately unused) -> hysteresis
// hold (holdFloor). Only the ENTRY/EXIT layer is new.
//
// EXIT = MFE-RATCHET TRAIL. Track the best favorable excursion (MFE) since entry. Once MFE
// reaches armPts, exit if price gives back mfeFrac of the peak MFE (a % ratchet: tightens as
// the trade travels further, so a big runner is protected proportionally). A trade also exits
// (and reverses) when the detector flips to the OPPOSITE trend. Before the arm level, a hard
// initStopPts protects against an immediate adverse move.
//
// HONEST STATUS (do NOT treat as proven): on the 3-week OOS window this nets positive, BUT
// ~85-95% of the profit is SHORT-side -- that window was net-down, so shorts print regardless
// of detector skill. The long side is ~flat. This is a regime artifact until a 5yr test shows
// the LONG side also earns and the edge is not just "shorts in a down month". High trade count
// (~20+/day) makes it slippage-sensitive. Treat as a hypothesis pending 5yr + both-sides proof.
// =====================================================================================
strategy("Streak Trend Strategy", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false,
     process_orders_on_close=true, max_labels_count=500)

pivLen   = input.int(7,  "Pivot half-width (bars each side; = confirmation lag)", minval=1, maxval=50, group="Detector")
smoothMed= input.bool(true, "Median-3 smooth high/low before pivots", group="Detector")
streakTh = input.int(2,  "Streak: fire after this many same-dir swing steps", minval=1, maxval=10, group="Detector")

enableConf = input.bool(true, "Require OLS displacement confirmation", group="Confirmation")
confN      = input.int(90,  "OLS confirm window (bars)", minval=10, maxval=400, group="Confirmation")
confRunPts = input.float(50.0, "Min OLS run |slope|*(N-1) in pts to START a trend", minval=0.0, step=5.0, group="Confirmation")
holdFloor  = input.float(40.0, "Hold a trend while OLS run stays above this (hysteresis)", minval=0.0, step=5.0, group="Confirmation")

tradeLong  = input.bool(true, "Trade long (on UP)",  group="Trades")
tradeShort = input.bool(true, "Trade short (on DOWN)", group="Trades")
mfeFrac    = input.float(0.5, "MFE trail: give back this fraction of peak MFE", minval=0.05, maxval=0.95, step=0.05, group="Exit")
armPts     = input.float(40.0, "MFE trail arms once favorable excursion reaches this (pts)", minval=1.0, step=5.0, group="Exit")
initStopPts= input.float(60.0, "Initial hard stop before the trail arms (pts)", minval=1.0, step=5.0, group="Exit")
flipExits  = input.bool(true, "Opposite-trend flip also exits/reverses", group="Exit")

med3(src) =>
    math.max(math.min(src, src[1]), math.min(math.max(src, src[1]), src[2]))

srcHi = smoothMed ? med3(high) : high
srcLo = smoothMed ? med3(low)  : low

pivHi = ta.pivothigh(srcHi, pivLen, pivLen)
pivLo = ta.pivotlow(srcLo,  pivLen, pivLen)

var float lastPivHi = na
var float lastPivLo = na
var int   upStreak   = 0
var int   downStreak = 0

if not na(pivHi)
    if not na(lastPivHi)
        if pivHi < lastPivHi
            downStreak += 1
            upStreak := 0
        else if pivHi > lastPivHi
            upStreak += 1
            downStreak := 0
    lastPivHi := pivHi

if not na(pivLo)
    if not na(lastPivLo)
        if pivLo < lastPivLo
            downStreak += 1
            upStreak := 0
        else if pivLo > lastPivLo
            upStreak += 1
            downStreak := 0
    lastPivLo := pivLo

int streakState = 0
if downStreak >= streakTh
    streakState := -1
else if upStreak >= streakTh
    streakState := 1

confSlope = ta.linreg(close, confN, 0) - ta.linreg(close, confN, 1)
confRun   = math.abs(confSlope) * (confN - 1)
confDir   = confSlope > 0 ? 1 : -1
startOk   = not enableConf or (confRun >= confRunPts and confDir == streakState)

var int trendState = 0
if trendState != 0
    holdOk = not enableConf or (confRun >= holdFloor and confDir == trendState)
    if streakState != 0 and startOk and streakState != trendState
        trendState := streakState
    else if not holdOk
        trendState := 0
if trendState == 0 and streakState != 0 and startOk
    trendState := streakState

var int prevState = 0
bool turnedUp   = trendState == 1  and prevState != 1
bool turnedDown = trendState == -1 and prevState != -1
prevState := trendState

var float entryPx = na
var float peakMFE = 0.0
var int   posDir  = 0

curFav = posDir != 0 and not na(entryPx) ? (posDir == 1 ? close - entryPx : entryPx - close) : 0.0
barFav = posDir != 0 and not na(entryPx) ? (posDir == 1 ? high - entryPx : entryPx - low) : 0.0
if posDir != 0
    peakMFE := math.max(peakMFE, barFav)

trailHit = false
if posDir != 0 and peakMFE >= armPts
    if (peakMFE - curFav) >= mfeFrac * peakMFE
        trailHit := true

stopHit = false
if posDir != 0 and peakMFE < armPts
    adverse = posDir == 1 ? entryPx - low : high - entryPx
    if adverse >= initStopPts
        stopHit := true

flipHit = flipExits and posDir != 0 and trendState != 0 and trendState != posDir

wantLong  = trendState == 1  and tradeLong
wantShort = trendState == -1 and tradeShort

if posDir != 0 and (trailHit or stopHit or flipHit)
    strategy.close_all(comment = trailHit ? "mfe-trail" : stopHit ? "init-stop" : "flip")
    posDir := 0
    entryPx := na
    peakMFE := 0.0

if posDir == 0
    if wantLong
        strategy.entry("Long", strategy.long)
        posDir := 1
        entryPx := close
        peakMFE := 0.0
    else if wantShort
        strategy.entry("Short", strategy.short)
        posDir := -1
        entryPx := close
        peakMFE := 0.0

bgcolor(trendState == 1  ? color.new(color.green, 90) : na)
bgcolor(trendState == -1 ? color.new(color.red,   90) : na)

var table cityTable = table.new(position.bottom_right, 1, 1, border_width=1)
if barstate.islast
    table.cell(cityTable, 0, 0, "Kobe", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 10))

plot(pivLen,      "P_pivLen",     color=na, display=display.data_window)
plot(streakTh,    "P_streakTh",   color=na, display=display.data_window)
plot(confN,       "P_confN",      color=na, display=display.data_window)
plot(confRunPts,  "P_confRunPts", color=na, display=display.data_window)
plot(holdFloor,   "P_holdFloor",  color=na, display=display.data_window)
plot(mfeFrac,     "P_mfeFrac",    color=na, display=display.data_window)
plot(armPts,      "P_armPts",     color=na, display=display.data_window)
plot(initStopPts, "P_initStopPts",color=na, display=display.data_window)
plot(trendState,  "trend state",  color=na, display=display.data_window)
plot(peakMFE,     "peak MFE",     color=na, display=display.data_window)
