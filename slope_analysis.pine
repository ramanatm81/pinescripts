//@version=6
// Analysis-only companion to slope_strategy_v2 — NO trades. Draws S/R pivots + VWAP ±2σ
// and exports per-bar values (slope, angle, S/R, spread, VWAP distances) to the Data Window
// so the setups can be eyeballed. Pure indicator(): no strategy.* calls, nothing fires.
indicator("Slope Analysis (no trades)", overlay=true, max_labels_count=500, max_bars_back=5000)

//=============================
// Inputs
//=============================
lookback     = 10  // fixed rolling window for the OLS slope
dojiPct      = input.float(10.0, "Doji body % of range (excluded from slope buffer)", minval=1.0, maxval=49.0, step=1.0, group="Slope")
angleAtrLen  = input.int(14,     "ATR length for slope angle",                        minval=1, maxval=200, group="Slope")

srHalfWidth  = input.int(10,     "Fractal half-width (bars each side, 10=21-bar pivot)", minval=1, maxval=20, group="S/R")
srZoneWidth  = input.float(25.0, "Zone width (pts either side of pivot)",  minval=1.0, step=0.5, group="S/R")
srLookback   = input.int(0,      "Pivot lookback (bars, 0=all)",           minval=0, maxval=500, group="S/R")
showSRZones  = input.bool(true,  "Draw S/R zones (±zone band around active pivots)", group="S/R")

showVwapSR   = input.bool(true,  "Draw VWAP ±2σ bands (daily-anchored)",   group="VWAP")

//=============================
// Per-bar metrics
//=============================
eodClose = (hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")) >= 900 and
           (hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")) < 960

_range   = high - low
_bodyPct = _range > 0.0 ? (math.abs(close - open) / _range) * 100.0 : 0.0
isDoji   = _bodyPct < dojiPct

//=============================
// OLS slope of close over the last `lookback` non-doji bars (points per bar)
//=============================
var float[] slopeBuf = array.new_float(0)
var float   legSlope = na
legSlope := na

if not eodClose and not isDoji
    array.push(slopeBuf, close)
    if array.size(slopeBuf) > lookback
        array.shift(slopeBuf)

if array.size(slopeBuf) == lookback
    n     = lookback
    sumX  = 0.0
    sumY  = 0.0
    sumXY = 0.0
    sumX2 = 0.0
    for i = 0 to n - 1
        x      = float(i)
        y      = array.get(slopeBuf, i)
        sumX  += x
        sumY  += y
        sumXY += x * y
        sumX2 += x * x
    denom    = n * sumX2 - sumX * sumX
    legSlope := denom != 0.0 ? math.round((n * sumXY - sumX * sumY) / denom, 2) : 0.0

// ATR-normalized geometric angle of legSlope (degrees). Both axes must share units, so the
// x-axis is scaled by ATR (points that equal one bar's typical move). angle = atan(slope/ATR).
_atrForAngle  = ta.atr(angleAtrLen)
legSlopeAngle = (not na(legSlope) and not na(_atrForAngle) and _atrForAngle > 0) ? math.round(math.atan(legSlope / _atrForAngle) * 180.0 / math.pi, 1) : na

//=============================
// S/R fractal pivots
//=============================
fractalHighVal = ta.pivothigh(high, srHalfWidth, srHalfWidth)
fractalLowVal  = ta.pivotlow(low,  srHalfWidth, srHalfWidth)
fractalHigh    = not na(fractalHighVal)
fractalLow     = not na(fractalLowVal)

var float lastFractalHigh    = na
var float lastFractalLow     = na
var int   lastFractalHighBar = na
var int   lastFractalLowBar  = na

if fractalHigh
    lastFractalHigh    := fractalHighVal
    lastFractalHighBar := bar_index - srHalfWidth
if fractalLow
    lastFractalLow     := fractalLowVal
    lastFractalLowBar  := bar_index - srHalfWidth

_highAge   = na(lastFractalHighBar) ? na : bar_index - lastFractalHighBar
_lowAge    = na(lastFractalLowBar)  ? na : bar_index - lastFractalLowBar
_highValid = not na(lastFractalHigh) and (srLookback == 0 or (not na(_highAge) and _highAge <= srLookback))
_lowValid  = not na(lastFractalLow)  and (srLookback == 0 or (not na(_lowAge)  and _lowAge  <= srLookback))

supportLvl    = _lowValid  ? lastFractalLow  : na
resistanceLvl = _highValid ? lastFractalHigh : na
srSpread      = (not na(supportLvl) and not na(resistanceLvl)) ? resistanceLvl - supportLvl : na

//=============================
// S/R drawings — pivot lines + shaded ±zone bands
//=============================
_lineH = (showSRZones and _highValid) ? lastFractalHigh : na
_lineL = (showSRZones and _lowValid)  ? lastFractalLow  : na
_pHiTop = plot(na(_lineH) ? na : _lineH + srZoneWidth, "srHi zone top", color=na, display=display.all)
_pHiBot = plot(na(_lineH) ? na : _lineH - srZoneWidth, "srHi zone bot", color=na, display=display.all)
_pLoTop = plot(na(_lineL) ? na : _lineL + srZoneWidth, "srLo zone top", color=na, display=display.all)
_pLoBot = plot(na(_lineL) ? na : _lineL - srZoneWidth, "srLo zone bot", color=na, display=display.all)
plot(_lineH, "srHi pivot (resistance)", color=na(_lineH) ? na : color.new(color.red, 0),   linewidth=1, display=display.all)
plot(_lineL, "srLo pivot (support)",    color=na(_lineL) ? na : color.new(color.green, 0), linewidth=1, display=display.all)
fill(_pHiTop, _pHiBot, color=na(_lineH) ? na : color.new(color.red, 88),   title="srHi band")
fill(_pLoTop, _pLoBot, color=na(_lineL) ? na : color.new(color.green, 88), title="srLo band")

//=============================
// VWAP ±2σ bands (daily-anchored) — volume-weighted
//=============================
[_vwapVal, _vwapUp, _vwapLo] = ta.vwap(hlc3, timeframe.change("D"), 2.0)
plot(showVwapSR ? _vwapUp  : na, "VWAP +2σ", color=showVwapSR ? color.new(color.red,   0)  : na, linewidth=2, display=display.all)
plot(showVwapSR ? _vwapVal : na, "VWAP",     color=showVwapSR ? color.new(color.gray,  20) : na, linewidth=1, display=display.all)
plot(showVwapSR ? _vwapLo  : na, "VWAP −2σ", color=showVwapSR ? color.new(color.green, 0)  : na, linewidth=2, display=display.all)

// distances beyond the bands (positive = pierced past the band; na when inside)
_aboveUpper = (not na(_vwapUp) and high > _vwapUp) ? high - _vwapUp : na   // how far the high is above +2σ
_belowLower = (not na(_vwapLo) and low  < _vwapLo) ? _vwapLo - low  : na   // how far the low is below −2σ

//=============================
// Per-bar values → Data Window (this is what you analyze)
//=============================
plot(legSlope,        "legSlope (pts/bar)",  color=color.rgb(100,180,255), display=display.data_window)
plot(legSlopeAngle,   "legSlopeAngle (deg)", color=color.rgb(140,200,255), display=display.data_window)
plot(supportLvl,      "support (pivot low)",  color=color.rgb(100,200,100), display=display.data_window)
plot(resistanceLvl,   "resistance (pivot high)", color=color.rgb(255,100,100), display=display.data_window)
plot(srSpread,        "spread (res−supp)",   color=color.rgb(120,200,255), display=display.data_window)
plot(_vwapUp,         "vwap_upper",          color=color.gray, display=display.data_window)
plot(_vwapVal,        "vwap_mean",           color=color.gray, display=display.data_window)
plot(_vwapLo,         "vwap_lower",          color=color.gray, display=display.data_window)
plot(_aboveUpper,     "beyond_+2σ (pts)",    color=color.rgb(255,140,140), display=display.data_window)
plot(_belowLower,     "beyond_−2σ (pts)",    color=color.rgb(140,255,140), display=display.data_window)
plot(_bodyPct,        "bodyPct",             color=color.yellow, display=display.data_window)
plot(isDoji ? 1 : 0,  "isDoji",              color=color.yellow, display=display.data_window)
